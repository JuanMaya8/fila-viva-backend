NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins (HTTP CORS and WebSocket).
FRONTEND_URL=http://localhost:3001
# Number of reverse proxies in front of the app (1 on Render/Vercel rewrites).
TRUST_PROXY_HOPS=1

# PostgreSQL. Either DATABASE_URL (Neon/Render, TLS enforced) or the DB_* fields.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=filaviva
DB_PASSWORD=filaviva
DB_NAME=filaviva
DB_POOL_SIZE=10

# Optional. Leave empty to rebuild queue snapshots from PostgreSQL only.
REDIS_URL=redis://localhost:6379
REDIS_SNAPSHOT_TTL_SECONDS=600

# Session signing secret: long random string, never commit the real one.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=28800
# true when served over HTTPS (defaults to true in production).
COOKIE_SECURE=false

# Initial administrator created by `npm run seed` (only if it does not exist).
ADMIN_EMAIL=admin@bancodemo.test
ADMIN_PASSWORD=replace-with-a-strong-password

# Shared secret between this backend and fila-viva-ai (header X-API-Key).
INTERNAL_API_KEY=replace-with-a-long-random-key

# Base URL of the fila-viva-ai service (see that repository).
PREDICTION_SERVICE_URL=http://localhost:8000
PREDICTION_TIMEOUT_MS=4000

# Queue behaviour.
ABSENT_TIMEOUT_MINUTES=3
QUEUE_REFRESH_SECONDS=30
ADVISOR_DISCONNECT_GRACE_SECONDS=45

# Rate limits (requests per minute per IP).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TURNS_PER_MINUTE=20
